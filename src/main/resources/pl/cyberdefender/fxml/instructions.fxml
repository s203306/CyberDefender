<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Ekran: Instrukcja -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pl.cyberdefender.controller.InstructionsController"
            styleClass="instructions">

    <padding>
        <Insets top="24.0" right="40.0" bottom="24.0" left="40.0"/>
    </padding>

    <top>
        <Label styleClass="title" text="%instructions.title">
            <BorderPane.margin>
                <Insets bottom="16.0"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="instructions-scroll">
            <VBox styleClass="instructions-sections" spacing="24.0">
                <padding>
                    <Insets top="8.0" right="16.0" bottom="8.0" left="8.0"/>
                </padding>

                <!-- Cel gry i rola gracza -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.goal.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.section.goal.text"/>
                </VBox>

                <!-- Przebieg rundy -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.round.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.section.round.text"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.round.order"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.round.step1"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.round.step2"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.round.step3"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.round.after"/>
                </VBox>

                <!-- Statusy urządzeń -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.status.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.section.status.text"/>
                    <Label styleClass="section-text, status-unknown" wrapText="true" text="%instructions.status.unknown"/>
                    <Label styleClass="section-text, status-suspicious" wrapText="true" text="%instructions.status.suspicious"/>
                    <Label styleClass="section-text, status-clean" wrapText="true" text="%instructions.status.clean"/>
                    <Label styleClass="section-text, status-infected" wrapText="true" text="%instructions.status.infected"/>
                    <Label styleClass="section-text, marker-isolated" wrapText="true" text="%instructions.marker.isolated"/>
                    <Label styleClass="section-text, marker-repair" wrapText="true" text="%instructions.marker.inRepair"/>
                    <Label styleClass="section-text, marker-account-blocked" wrapText="true" text="%instructions.marker.accountBlocked"/>
                    <Label styleClass="section-text, marker-critical" wrapText="true" text="%instructions.marker.critical"/>
                </VBox>

                <!-- Akcje gracza -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.actions.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.action.viewLogs"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.action.scan"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.action.isolate"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.action.blockAccount"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.action.restore"/>
                </VBox>

                <!-- Zasoby -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.resources.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.resources.budget"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.resources.actionsPerRound"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.resources.roundLimit"/>
                </VBox>

                <!-- Warunki zakończenia -->
                <VBox spacing="6.0">
                    <Label styleClass="section-header" text="%instructions.section.end.title"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.end.databaseLost"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.end.success"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.end.partialSuccess"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.end.timeout"/>
                    <Label styleClass="section-text" wrapText="true" text="%instructions.end.noBudget"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <BorderPane.margin>
                <Insets top="16.0"/>
            </BorderPane.margin>
            <Button styleClass="menu-button" text="%common.button.back"
                    prefWidth="160.0" prefHeight="44.0" onAction="#onBack"/>
        </HBox>
    </bottom>
</BorderPane>