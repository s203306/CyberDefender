<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Ekran: Menu główne -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pl.cyberdefender.controller.MainMenuController"
      styleClass="main-menu"
      alignment="CENTER"
      spacing="16.0">

    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <Label styleClass="title" text="%menu.title"/>
    <Label styleClass="subtitle" text="%menu.subtitle" wrapText="true"/>
    <Label styleClass="motto" text="%menu.motto" wrapText="true">
        <VBox.margin>
            <Insets bottom="24.0"/>
        </VBox.margin>
    </Label>

    <VBox styleClass="menu-buttons" alignment="CENTER" spacing="12.0">
        <Button styleClass="menu-button" text="%menu.button.newGame"
                prefWidth="240.0" prefHeight="48.0" onAction="#onNewGame"/>
        <Button styleClass="menu-button" text="%menu.button.instructions"
                prefWidth="240.0" prefHeight="48.0" onAction="#onInstructions"/>
        <Button styleClass="menu-button" text="%menu.button.exit"
                prefWidth="240.0" prefHeight="48.0" onAction="#onExit"/>
    </VBox>
</VBox>